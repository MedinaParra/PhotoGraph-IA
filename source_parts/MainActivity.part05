                    if(jump.contains(x,y))jump(); else if(trick.contains(x,y)){trickHeld=true;haptic();}
                }
                return true;
            }
        }

        // ---------------------- MINIGAME: BOUNCING BALL ----------------------
        private final class BallGame {
            private final RectF back=new RectF(),left=new RectF(),right=new RectF(),retry=new RectF();
            private final List<Platform> platforms=new ArrayList<>();
            private float x,y,vx,vy; private int score,colorIndex; private boolean over,leftHeld,rightHeld;
            void reset(){platforms.clear();float w=getWidth(),h=getHeight();for(int i=0;i<6;i++)platforms.add(new Platform(w*(.08f+rnd.nextFloat()*.55f),h*(.72f-i*.115f),w*(.26f+rnd.nextFloat()*.20f)));x=w*.5f;y=h*.60f;vx=0;vy=-h*.50f;score=0;colorIndex=5;over=false;leftHeld=rightHeld=false;}
            void update(float dt){if(over)return;float w=getWidth(),h=getHeight();if(leftHeld)vx-=w*1.2f*dt;if(rightHeld)vx+=w*1.2f*dt;vx*=.985f;x+=vx*dt;vy+=h*1.15f*dt;y+=vy*dt;if(x<18){x=18;vx=Math.abs(vx)*.75f;}if(x>w-18){x=w-18;vx=-Math.abs(vx)*.75f;}
                float r=w*.045f;for(Platform pl:platforms){pl.phase+=dt;pl.x+=Math.sin(pl.phase)*w*.015f*dt;if(vy>0&&y+r>=pl.y&&y+r-vy*dt<pl.y&&x>pl.x-r&&x<pl.x+pl.w+r){y=pl.y-r;vy=-h*(.52f+Math.min(.12f,score*.003f));score++;colorIndex=(colorIndex+1)%MAGIC.length;burst(x,y,8);if(score%5==0)coins++;}}
                if(y>h*.84f)over=true;
            }
            void draw(Canvas c,float w,float h){p.setShader(new LinearGradient(0,0,0,h,0xFF1D2858,0xFF51266D,Shader.TileMode.CLAMP));c.drawRect(0,0,w,h,p);p.setShader(null);drawMiniHeader(c,w,h,"BOLA SALTARINA",score,back);
                p.setColor(0x33FFFFFF);for(int i=0;i<20;i++)star(c,(i*73f)%w,h*(.18f+(i%6)*.085f),3+i%3,p);
                for(Platform pl:platforms){p.setColor(0x33000000);round(c,pl.x,pl.y+8,pl.x+pl.w,pl.y+h*.025f+8,15,p);p.setColor(MAGIC[((int)(pl.y/30))%MAGIC.length]);round(c,pl.x,pl.y,pl.x+pl.w,pl.y+h*.025f,15,p);p.setColor(0x55FFFFFF);round(c,pl.x+5,pl.y+3,pl.x+pl.w-5,pl.y+h*.010f,8,p);}
                float r=w*.047f;p.setColor(0x33000000);c.drawCircle(x+5,y+8,r,p);p.setShader(new LinearGradient(x-r,y-r,x+r,y+r,blend(MAGIC[colorIndex],Color.WHITE,.45f),MAGIC[colorIndex],Shader.TileMode.CLAMP));c.drawCircle(x,y,r,p);p.setShader(null);p.setColor(0x99FFFFFF);c.drawCircle(x-r*.3f,y-r*.35f,r*.20f,p);
                left.set(w*.08f,h*.85f,w*.45f,h*.93f);right.set(w*.55f,h*.85f,w*.92f,h*.93f);miniButton(c,left,"◀ IZQUIERDA",MAGIC[2]);miniButton(c,right,"DERECHA ▶",MAGIC[0]);p.setColor(Color.WHITE);text(c,"La bola comienza roja y cambia de color en cada rebote",w*.5f,h*.80f,w*.022f,Paint.Align.CENTER,true);if(over)drawGameOver(c,w,h,"LA BOLA CAYÓ",score,Math.max(1,score/6),retry);}
            boolean touch(MotionEvent e){float tx=e.getX(),ty=e.getY();if(e.getAction()==MotionEvent.ACTION_DOWN){leftHeld=left.contains(tx,ty);rightHeld=right.contains(tx,ty);return true;}if(e.getAction()==MotionEvent.ACTION_UP||e.getAction()==MotionEvent.ACTION_CANCEL){leftHeld=rightHeld=false;if(back.contains(tx,ty)){leaveGame(Math.max(0,score/7),"Bola saltarina");return true;}if(over&&retry.contains(tx,ty))reset();return true;}return true;}
        }

        // ---------------------- MINIGAME: PLANE ----------------------
        private final class PlaneGame {
            private final RectF back=new RectF(),retry=new RectF();private final List<Gate> gates=new ArrayList<>();private float y,vy,speed;private int score,passed;private boolean over;
            void reset(){gates.clear();float w=getWidth(),h=getHeight();for(int i=0;i<3;i++)gates.add(new Gate(w*(1.2f+i*.62f),h*(.31f+rnd.nextFloat()*.30f),h*.23f));y=h*.48f;vy=0;speed=w*.28f;score=passed=0;over=false;}
            void update(float dt){if(over)return;float w=getWidth(),h=getHeight();vy+=h*.88f*dt;y+=vy*dt;for(Gate g:gates){g.x-=speed*dt;if(!g.counted&&g.x+w*.06f<w*.25f){g.counted=true;score++;if(score%4==0)coins++;}if(g.x<-w*.12f){float max=0;for(Gate z:gates)max=Math.max(max,z.x);g.x=max+w*(.52f+rnd.nextFloat()*.22f);g.gapY=h*(.30f+rnd.nextFloat()*.38f);g.gap=h*(.20f+rnd.nextFloat()*.07f);g.counted=false;}float px=w*.24f,r=w*.045f;if(g.x<px+r&&g.x+w*.10f>px-r&&(y-r<g.gapY-g.gap/2||y+r>g.gapY+g.gap/2))over=true;}if(y<h*.16f||y>h*.80f)over=true;speed=Math.min(w*.48f,speed+w*.0025f*dt);}
            void flap(){if(!over){vy=-getHeight()*.40f;haptic();}}
            void draw(Canvas c,float w,float h){p.setShader(new LinearGradient(0,0,0,h,0xFF79D7FF,0xFFD6F5FF,Shader.TileMode.CLAMP));c.drawRect(0,0,w,h,p);p.setShader(null);drawMiniHeader(c,w,h,"AVIÓN MÁGICO",score,back);p.setColor(0xFFFFE16A);c.drawCircle(w*.82f,h*.20f,w*.065f,p);cloud(c,w*.20f,h*.30f,w*.08f);cloud(c,w*.67f,h*.48f,w*.07f);
                for(Gate g:gates){p.setColor(0xFF65B65C);round(c,g.x,h*.14f,g.x+w*.10f,g.gapY-g.gap/2,14,p);round(c,g.x,g.gapY+g.gap/2,g.x+w*.10f,h*.82f,14,p);p.setColor(0xFF4B9B48);c.drawOval(new RectF(g.x-w*.03f,g.gapY-g.gap/2-h*.025f,g.x+w*.13f,g.gapY-g.gap/2+h*.025f),p);c.drawOval(new RectF(g.x-w*.03f,g.gapY+g.gap/2-h*.025f,g.x+w*.13f,g.gapY+g.gap/2+h*.025f),p);}
                drawPlane(c,w*.24f,y,w*.10f);p.setColor(0xFF4E5770);text(c,"Toca cualquier parte para volar",w*.5f,h*.89f,w*.026f,Paint.Align.CENTER,true);if(over)drawGameOver(c,w,h,"ATERRIZAJE",score,Math.max(1,score/5),retry);}
            boolean touch(MotionEvent e){if(e.getAction()!=MotionEvent.ACTION_UP)return true;float x=e.getX(),yy=e.getY();if(back.contains(x,yy)){leaveGame(Math.max(0,score/6),"Avión");return true;}if(over){if(retry.contains(x,yy))reset();}else flap();return true;}
        }

        // ---------------------- SHARED MINIGAME UI ----------------------
        private void drawMiniHeader(Canvas c,float w,float h,String title,int score,RectF back){p.setColor(0xDFFFFFFF);round(c,w*.035f,h*.025f,w*.965f,h*.12f,25,p);back.set(w*.055f,h*.045f,w*.20f,h*.10f);p.setColor(0xFF5A3B72);round(c,back.left,back.top,back.right,back.bottom,16,p);p.setColor(Color.WHITE);text(c,"‹ SALIR",back.centerX(),back.centerY()+h*.008f,w*.020f,Paint.Align.CENTER,true);p.setColor(0xFF5A3B72);text(c,title,w*.5f,h*.082f,w*.036f,Paint.Align.CENTER,true);p.setColor(0xFFFFB52E);star(c,w*.83f,h*.073f,w*.020f,p);p.setColor(0xFF5A3B72);text(c,String.valueOf(score),w*.91f,h*.084f,w*.030f,Paint.Align.RIGHT,true);}
        private void drawGameOver(Canvas c,float w,float h,String title,int score,int reward,RectF retry){p.setColor(0xB0000000);c.drawRect(0,0,w,h,p);RectF card=new RectF(w*.12f,h*.25f,w*.88f,h*.68f);p.setColor(0xFFFDF8FF);round(c,card.left,card.top,card.right,card.bottom,30,p);p.setColor(0xFF5A3B72);text(c,title,w*.5f,h*.34f,w*.045f,Paint.Align.CENTER,true);text(c,"Puntaje: "+score,w*.5f,h*.405f,w*.031f,Paint.Align.CENTER,true);p.setColor(0xFFFFB52E);star(c,w*.42f,h*.47f,w*.027f,p);p.setColor(0xFF5A3B72);text(c,"Premio estimado: "+reward,w*.47f,h*.482f,w*.025f,Paint.Align.LEFT,true);retry.set(w*.28f,h*.55f,w*.72f,h*.625f);miniButton(c,retry,"JUGAR DE NUEVO",MAGIC[0]);}
        private void miniButton(Canvas c,RectF r,String label,int color){p.setColor(0x33000000);round(c,r.left,r.top+5,r.right,r.bottom+5,20,p);p.setColor(color);round(c,r.left,r.top,r.right,r.bottom,20,p);p.setColor(Color.WHITE);text(c,label,r.centerX(),r.centerY()-(p.ascent()+p.descent())/2,getWidth()*.023f,Paint.Align.CENTER,true);}

        // ---------------------- DRAWING HELPERS ----------------------
        private void drawIcon(Canvas c,int icon,float x,float y,float s,int color){p.setColor(color);stroke.setColor(color);stroke.setStrokeWidth(Math.max(2,s*.16f));
            if(icon==0){stroke.setStrokeWidth(s*.20f);c.drawLine(x-s*.7f,y,x+s*.7f,y,stroke);Path q=new Path();q.moveTo(x+s*.55f,y-s*.35f);q.lineTo(x+s*.85f,y);q.lineTo(x+s*.55f,y+s*.35f);c.drawPath(q,stroke);}
            else if(icon==1){heart(c,x,y,s*.72f,color);}else if(icon==2){Path q=new Path();q.moveTo(x-s*.7f,y+s*.25f);q.lineTo(x,y-s*.6f);q.lineTo(x+s*.7f,y+s*.25f);c.drawPath(q,stroke);c.drawLine(x,y-s*.55f,x,y+s*.7f,stroke);}else if(icon==3){p.setColor(color);c.drawOval(new RectF(x-s*.7f,y-s*.45f,x+s*.7f,y+s*.45f),p);p.setColor(0x55FFFFFF);c.drawOval(new RectF(x-s*.45f,y-s*.28f,x+s*.15f,y-s*.05f),p);}
            else if(icon>=10&&icon<=12){if(icon==10)drawSoap(c,x,y,s*.65f);else if(icon==11)drawBrush(c,x,y,s*.65f);else drawTowel(c,x,y,s*.65f);}
            else if(icon==13){c.drawCircle(x,y,s*.55f,p);stroke.setColor(Color.WHITE);stroke.setStrokeWidth(s*.10f);c.drawCircle(x,y,s*.38f,stroke);}
            else if(icon==20){p.setColor(color);c.drawCircle(x,y,s*.7f,p);p.setColor(Color.WHITE);star(c,x,y,s*.42f,p);}else if(icon==21){p.setShader(new LinearGradient(x-s,y,x+s,y,MAGIC[0],MAGIC[4],Shader.TileMode.CLAMP));c.drawCircle(x,y,s*.72f,p);p.setShader(null);}else if(icon==22){p.setColor(color);star(c,x,y,s*.72f,p);}else if(icon==23){p.setColor(color);for(int i=0;i<5;i++)star(c,x+(float)Math.cos(i*1.26)*s*.45f,y+(float)Math.sin(i*1.26)*s*.45f,s*.23f,p);}
            else if(icon==30){stroke.setColor(Color.WHITE);stroke.setStrokeWidth(s*.12f);for(int i=-1;i<=1;i++){c.drawLine(x-s*.62f,y+i*s*.35f,x+s*.62f,y+i*s*.35f,stroke);c.drawLine(x+i*s*.35f,y-s*.62f,x+i*s*.35f,y+s*.62f,stroke);}}
            else if(icon==31){drawSkateboard(c,x,y+s*.05f,s*.95f);}else if(icon==32){p.setColor(Color.WHITE);c.drawCircle(x,y,s*.65f,p);p.setColor(0x55FFFFFF);c.drawCircle(x-s*.22f,y-s*.25f,s*.18f,p);}else if(icon==33){drawPlane(c,x,y,s*.75f);}
            else if(icon==40){Path q=new Path();q.moveTo(x-s*.75f,y);q.lineTo(x,y-s*.65f);q.lineTo(x+s*.75f,y);q.lineTo(x+s*.58f,y);q.lineTo(x+s*.58f,y+s*.65f);q.lineTo(x-s*.58f,y+s*.65f);q.lineTo(x-s*.58f,y);q.close();c.drawPath(q,p);}else if(icon==41){p.setColor(color);c.drawCircle(x,y,s*.65f,p);p.setColor(0xFF5A3B72);c.drawCircle(x-s*.2f,y-s*.1f,s*.08f,p);stroke.setColor(0xFF5A3B72);stroke.setStrokeWidth(s*.08f);c.drawArc(new RectF(x-s*.32f,y-s*.05f,x+s*.32f,y+s*.4f),10,160,false,stroke);}else if(icon==42){p.setColor(color);c.drawCircle(x-s*.35f,y-s*.1f,s*.35f,p);c.drawCircle(x+s*.35f,y-s*.1f,s*.35f,p);round(c,x-s*.62f,y,x+s*.62f,y+s*.55f,s*.22f,p);}else if(icon==43){Path q=new Path();q.moveTo(x-s*.65f,y-s*.55f);q.lineTo(x+s*.65f,y-s*.55f);q.lineTo(x+s*.45f,y+s*.65f);q.lineTo(x-s*.45f,y+s*.65f);q.close();c.drawPath(q,p);p.setColor(0x55FFFFFF);c.drawRect(x-s*.45f,y-s*.35f,x+s*.45f,y-s*.10f,p);}else if(icon==44){stroke.setColor(color);stroke.setStrokeWidth(s*.13f);c.drawRect(x-s*.65f,y-s*.55f,x+s*.65f,y+s*.55f,stroke);c.drawLine(x-s*.22f,y-s*.55f,x-s*.22f,y+s*.55f,stroke);c.drawLine(x+s*.22f,y-s*.55f,x+s*.22f,y+s*.55f,stroke);c.drawLine(x-s*.65f,y-s*.18f,x+s*.65f,y-s*.18f,stroke);c.drawLine(x-s*.65f,y+s*.18f,x+s*.65f,y+s*.18f,stroke);}
        }

        private void drawPlane(Canvas c,float x,float y,float s){p.setColor(0xFFFFF7E6);Path q=new Path();q.moveTo(x-s*.9f,y+s*.12f);q.lineTo(x+s*.82f,y);q.lineTo(x-s*.22f,y-s*.25f);q.lineTo(x-s*.45f,y-s*.72f);q.lineTo(x-s*.68f,y-s*.65f);q.lineTo(x-s*.58f,y-s*.18f);q.close();c.drawPath(q,p);p.setColor(MAGIC[0]);Path wing=new Path();wing.moveTo(x-s*.2f,y);wing.lineTo(x+s*.25f,y+s*.75f);wing.lineTo(x-s*.18f,y+s*.52f);wing.lineTo(x-s*.52f,y+s*.06f);wing.close();c.drawPath(wing,p);p.setColor(MAGIC[2]);round(c,x-s*.10f,y-s*.14f,x+s*.22f,y+s*.12f,s*.10f,p);}
