            p.setColor(0xFF8A758F); text(c, "Compra y luego arrastra la comida desde abajo hasta la boca de A-tatis.", w * .5f, h * .775f, w * .020f, Paint.Align.CENTER, false);
        }

        private void drawDraggedItem(Canvas c, float x, float y, float s) {
            p.setColor(0x33000000); c.drawCircle(x + 5, y + 7, s * .75f, p);
            if (dragKind >= 0 && dragKind < 4) drawFood(c, dragKind, x, y, s);
            else if (dragKind == DRAG_SOAP) drawSoap(c, x, y, s);
            else if (dragKind == DRAG_BRUSH) drawBrush(c, x, y, s);
            else if (dragKind == DRAG_TOWEL) drawTowel(c, x, y, s);
        }

        private void drawFood(Canvas c, int kind, float x, float y, float s) {
            if (kind == 0) {
                p.setColor(0xFFEF5350); c.drawCircle(x, y, s * .78f, p); c.drawCircle(x + s * .45f, y, s * .67f, p);
                stroke.setColor(0xFF6D4C41); stroke.setStrokeWidth(s * .13f); c.drawLine(x + s * .22f, y - s * .65f, x + s * .27f, y - s * 1.05f, stroke);
                p.setColor(0xFF4CAF50); c.drawOval(new RectF(x + s * .2f, y - s * 1.0f, x + s * .85f, y - s * .55f), p);
            } else if (kind == 1) {
                p.setColor(0xFFFF8A3D); Path q = new Path(); q.moveTo(x - s * .65f, y - s * .55f); q.lineTo(x + s * .75f, y); q.lineTo(x - s * .55f, y + s * .55f); q.close(); c.drawPath(q, p);
                stroke.setColor(0xFF4CAF50); stroke.setStrokeWidth(s * .13f); for (int i = -1; i <= 1; i++) c.drawLine(x - s * .55f, y, x - s * .95f, y + i * s * .5f, stroke);
            } else if (kind == 2) {
                p.setColor(0xFFFFD7A8); round(c, x - s * .72f, y - s * .25f, x + s * .72f, y + s * .65f, s * .25f, p);
                p.setColor(0xFFFF70A6); c.drawOval(new RectF(x - s * .78f, y - s * .72f, x + s * .78f, y + s * .12f), p);
                p.setColor(0xFFFFD166); star(c, x, y - s * .55f, s * .28f, p);
            } else {
                p.setColor(0xFF7C8CFF); round(c, x - s * .55f, y - s * .72f, x + s * .55f, y + s * .65f, s * .18f, p);
                p.setColor(0xFFCCF2FF); round(c, x - s * .42f, y - s * .45f, x + s * .42f, y + s * .38f, s * .12f, p);
                p.setColor(MAGIC[0]); c.drawCircle(x - s * .15f, y, s * .13f, p); p.setColor(MAGIC[2]); c.drawCircle(x + s * .18f, y - s * .13f, s * .13f, p);
                stroke.setColor(0xFFFFE37A); stroke.setStrokeWidth(s * .1f); c.drawLine(x + s * .18f, y - s * .68f, x + s * .60f, y - s * 1.12f, stroke);
            }
        }

        private void drawSoap(Canvas c, float x, float y, float s) {
            p.setColor(0xFF6FD9E8); round(c, x - s * .8f, y - s * .52f, x + s * .8f, y + s * .52f, s * .32f, p);
            p.setColor(0x77FFFFFF); round(c, x - s * .55f, y - s * .33f, x + s * .2f, y - s * .12f, s * .1f, p);
            p.setColor(Color.WHITE); text(c, "SOAP", x, y + s * .12f, s * .28f, Paint.Align.CENTER, true);
        }

        private void drawBrush(Canvas c, float x, float y, float s) {
            p.setColor(0xFFFF70A6); round(c, x - s * .8f, y - s * .16f, x + s * .65f, y + s * .18f, s * .17f, p);
            p.setColor(0xFFF8F8FF); round(c, x + s * .35f, y - s * .50f, x + s * .88f, y + s * .5f, s * .14f, p);
            stroke.setColor(0xFF7C8CFF); stroke.setStrokeWidth(s * .07f); for (int i = 0; i < 5; i++) c.drawLine(x + s * (.43f + i * .09f), y - s * .46f, x + s * (.43f + i * .09f), y - s * .72f, stroke);
        }

        private void drawTowel(Canvas c, float x, float y, float s) {
            p.setColor(0xFFFFD166); round(c, x - s * .75f, y - s * .58f, x + s * .75f, y + s * .58f, s * .08f, p);
            stroke.setColor(0xFFFFF3BE); stroke.setStrokeWidth(s * .05f); for (int i = -2; i <= 2; i++) c.drawLine(x + i * s * .22f, y + s * .5f, x + i * s * .22f, y + s * .74f, stroke);
        }

        private void drawBubbles(Canvas c) {
            for (Bubble b : bubbles) {
                int a = (int) (220 * Math.min(1, b.life));
                p.setColor(Color.argb(a / 3, 255, 255, 255)); c.drawCircle(b.x, b.y, b.r, p);
                stroke.setColor(Color.argb(a, 235, 255, 255)); stroke.setStrokeWidth(Math.max(2, b.r * .12f)); c.drawCircle(b.x, b.y, b.r, stroke);
                p.setColor(Color.argb(a, 255, 255, 255)); c.drawCircle(b.x - b.r * .33f, b.y - b.r * .34f, b.r * .18f, p);
            }
        }

        @Override public boolean onTouchEvent(MotionEvent e) {
            if (mode != HOME) return currentGameTouch(e);
            float x = e.getX(), y = e.getY();
            if (shopOpen) return handleShopTouch(e, x, y);

            if (e.getAction() == MotionEvent.ACTION_DOWN) {
                dragX = x; dragY = y;
                if (room == 1) {
                    for (int i = 0; i < 4; i++) if (dockRects[i] != null && dockRects[i].contains(x, y) && inventory[i] > 0) { dragKind = i; haptic(); return true; }
                } else if (room == 2) {
                    for (int i = 0; i < 3; i++) if (dockRects[i] != null && dockRects[i].contains(x, y)) { dragKind = DRAG_SOAP + i; soapProgress = 0; haptic(); return true; }
                }
            } else if (e.getAction() == MotionEvent.ACTION_MOVE) {
                if (dragKind != DRAG_NONE) { dragX = x; dragY = y; return true; }
            } else if (e.getAction() == MotionEvent.ACTION_UP || e.getAction() == MotionEvent.ACTION_CANCEL) {
                if (dragKind != DRAG_NONE) {
                    finishDrag(x, y); dragKind = DRAG_NONE; save(); return true;
                }
                for (int i = 0; i < 5; i++) if (navRects[i] != null && navRects[i].contains(x, y)) {
                    room = i; state = IDLE; shopOpen = false; say("Vamos a " + ROOMS[i].toLowerCase(Locale.ROOT)); burst(x, y, 12); haptic(); save(); return true;
                }
                if (room == 0 && sleepButton.contains(x, y)) {
                    state = state == SLEEP ? IDLE : SLEEP; say(state == SLEEP ? "Shhh… A-tatis está descansando" : "¡A-tatis despertó!"); haptic(); return true;
                }
                if (room == 1 && shopButton.contains(x, y)) { shopOpen = true; haptic(); return true; }
                for (int i = 0; i < 4; i++) if (dockRects[i] != null && dockRects[i].contains(x, y)) { dockTap(i); save(); return true; }
                // Touching the character gives a hug; touching the floor makes her walk.
                if (nearCapy(x, y)) {
                    happy = cap(happy + 8); state = HAPPY; stateTimer = 1.1f; say("¡Abrazo para A-tatis!"); burst(x, y, 18); haptic();
                } else if (y > getHeight() * .53f && y < getHeight() * .75f) {
                    targetX = clampf(x / getWidth(), .20f, .80f); state = WALK; say("¡Vamos para allá!");
                }
                return true;
            }
            return true;
        }

        private boolean handleShopTouch(MotionEvent e, float x, float y) {
            if (e.getAction() != MotionEvent.ACTION_UP) return true;
            if (closeButton.contains(x, y)) { shopOpen = false; return true; }
            for (int i = 0; i < 4; i++) if (shopCards[i].contains(x, y)) {
                if (coins >= FOOD_PRICE[i]) {
                    coins -= FOOD_PRICE[i]; inventory[i]++; say("Compraste " + FOOD_NAMES[i].toLowerCase(Locale.ROOT)); burst(x, y, 15); haptic(); save();
                } else say("Necesitas más estrellas jugando minijuegos");
                return true;
            }
            return true;
        }

        private void finishDrag(float x, float y) {
            if (dragKind >= 0 && dragKind < 4) {
                if (nearMouth(x, y) && inventory[dragKind] > 0) {
                    inventory[dragKind]--;
                    food = cap(food + FOOD_GAIN[dragKind]); happy = cap(happy + 4 + dragKind * 2); clean = cap(clean - (dragKind == 2 ? 3 : 1));
                    state = EAT; stateTimer = 1.8f; say("¡Ñam! A-tatis comió " + FOOD_NAMES[dragKind].toLowerCase(Locale.ROOT)); burst(x, y, 20); haptic();
                } else say("Lleva la comida hasta su boca");
            } else if (dragKind == DRAG_SOAP) {
                if (soapProgress >= .72f) { clean = cap(clean + 38); happy = cap(happy + 6); state = CLEAN; stateTimer = 1.8f; say("¡Limpieza completa y pelito brillante!"); burst(getWidth() * capyX, getHeight() * .5f, 26); }
                else say("Frota el jabón sobre A-tatis para crear burbujas");
            } else if (dragKind == DRAG_BRUSH) {
                if (nearCapy(x, y)) { clean = cap(clean + 18); happy = cap(happy + 5); state = CLEAN; stateTimer = 1.3f; say("¡Cepillado suave!"); burst(x, y, 15); }
            } else if (dragKind == DRAG_TOWEL) {
                if (nearCapy(x, y)) { clean = cap(clean + 12); energy = cap(energy + 3); state = HAPPY; stateTimer = 1.0f; say("¡Seca y calentita!"); burst(x, y, 12); }
            }
        }

        private void dockTap(int i) {
            if (room == 0) {
                if (i == 0) { targetX = capyX < .5f ? .76f : .24f; state = WALK; say("A-tatis camina por su habitación"); }
                else if (i == 1) { happy = cap(happy + 10); state = HAPPY; stateTimer = 1.1f; say("¡Abrazo gigante!"); burst(getWidth() * capyX, getHeight() * .5f, 18); }
                else if (i == 2) { state = HAPPY; stateTimer = 1.1f; energy = cap(energy - 2); happy = cap(happy + 5); say("¡Salto unicornio!"); }
                else { state = SLEEP; say("A-tatis recupera energía"); }
            } else if (room == 1) {
                if (inventory[i] <= 0) say("No queda " + FOOD_NAMES[i].toLowerCase(Locale.ROOT) + ". Visita la tienda.");
                else say("Mantén presionado y arrastra hasta su boca");
            } else if (room == 2) {
                if (i == 3) { for (int k = 0; k < 22; k++) addBubble(getWidth() * capyX + rand(-100, 100), getHeight() * .48f + rand(-100, 90), 7 + rnd.nextFloat() * 16); happy = cap(happy + 4); say("¡Fiesta de burbujas!"); }
                else say("Mantén presionado y arrastra el objeto sobre A-tatis");
            } else if (room == 3) {
                if (i == 0) { style = (style + 1) % STYLE_NAMES.length; say("Estilo: " + STYLE_NAMES[style]); }
                else if (i == 1) { fur = (fur + 1) % FUR.length; say("Color: " + COLOR_NAMES[fur]); }
                else if (i == 2) { style = rnd.nextInt(STYLE_NAMES.length); fur = rnd.nextInt(FUR.length); say("¡Cambio sorpresa!"); }
                else { state = HAPPY; stateTimer = 1.3f; burst(getWidth() * capyX, getHeight() * .48f, 28); say("¡Brillo mágico activado!"); }
                happy = cap(happy + 3); haptic();
            } else {
                startGame(i + 1);
            }
        }

        private void startGame(int gameMode) {
            mode = gameMode;
            if (mode == TETRIS) tetris.reset();
            else if (mode == SKATE) skate.reset();
            else if (mode == BALL) ball.reset();
            else if (mode == PLANE) plane.reset();
            haptic();
        }

        private boolean currentGameTouch(MotionEvent e) {
            if (mode == TETRIS) return tetris.touch(e);
            if (mode == SKATE) return skate.touch(e);
            if (mode == BALL) return ball.touch(e);
            return plane.touch(e);
        }

        private void leaveGame(int reward, String gameName) {
            if (reward > 0) {
                coins += reward; happy = cap(happy + Math.min(18, reward * 2));
