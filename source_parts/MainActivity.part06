        private void drawSkateboard(Canvas c,float x,float y,float s){p.setColor(0xFF5D3A77);round(c,x-s*.72f,y-s*.12f,x+s*.72f,y+s*.12f,s*.11f,p);p.setColor(MAGIC[0]);round(c,x-s*.55f,y-s*.08f,x+s*.55f,y+s*.02f,s*.06f,p);p.setColor(0xFF212735);c.drawCircle(x-s*.45f,y+s*.22f,s*.13f,p);c.drawCircle(x+s*.45f,y+s*.22f,s*.13f,p);p.setColor(0xFF9EA7B8);c.drawCircle(x-s*.45f,y+s*.22f,s*.045f,p);c.drawCircle(x+s*.45f,y+s*.22f,s*.045f,p);}
        private void drawArcadeMachine(Canvas c,float x,float y,float w,float h,int color,String symbol){drawBlock(c,x,y,w,h,h*.15f,0xFF343A63,0xFF171A31,0xFF4C4F7A);p.setColor(color);round(c,x+w*.16f,y+h*.13f,x+w*.84f,y+h*.51f,12,p);p.setColor(0xFF101427);round(c,x+w*.22f,y+h*.18f,x+w*.78f,y+h*.46f,8,p);p.setColor(color);text(c,symbol,x+w*.5f,y+h*.39f,w*.24f,Paint.Align.CENTER,true);p.setColor(0xFFED6B91);c.drawCircle(x+w*.37f,y+h*.67f,w*.05f,p);p.setColor(0xFFFFD166);c.drawCircle(x+w*.63f,y+h*.67f,w*.05f,p);}
        private void neonText(Canvas c,String s,float x,float y,float size,int color){p.setColor(0x55111111);text(c,s,x+4,y+5,size,Paint.Align.CENTER,true);stroke.setStyle(Paint.Style.STROKE);stroke.setStrokeWidth(8);stroke.setColor(Color.argb(90,Color.red(color),Color.green(color),Color.blue(color)));p.setColor(color);text(c,s,x,y,size,Paint.Align.CENTER,true);stroke.setStyle(Paint.Style.STROKE);}
        private void drawBlock(Canvas c,float x,float y,float w,float h,float depth,int front,int side,int top){p.setColor(0x28000000);Path sh=new Path();sh.moveTo(x+depth*.4f,y+h+depth*.5f);sh.lineTo(x+w+depth*.4f,y+h+depth*.5f);sh.lineTo(x+w+depth,y+h+depth);sh.lineTo(x+depth,y+h+depth);sh.close();c.drawPath(sh,p);p.setColor(front);round(c,x,y,x+w,y+h,12,p);Path right=new Path();right.moveTo(x+w,y);right.lineTo(x+w+depth,y+depth*.55f);right.lineTo(x+w+depth,y+h+depth*.55f);right.lineTo(x+w,y+h);right.close();p.setColor(side);c.drawPath(right,p);Path topP=new Path();topP.moveTo(x,y);topP.lineTo(x+depth,y-depth*.35f);topP.lineTo(x+w+depth,y+depth*.20f);topP.lineTo(x+w,y);topP.close();p.setColor(top);c.drawPath(topP,p);}
        private void shadowBox(Canvas c,float l,float t,float r,float b,float rad,int color){p.setColor(0x29000000);round(c,l+7,t+9,r+7,b+9,rad,p);p.setColor(color);round(c,l,t,r,b,rad,p);}
        private void button(Canvas c,RectF r,String s,int color,boolean bold){p.setColor(0x28000000);round(c,r.left,r.top+5,r.right,r.bottom+5,20,p);p.setColor(color);round(c,r.left,r.top,r.right,r.bottom,20,p);p.setColor(Color.WHITE);text(c,s,r.centerX(),r.centerY()-(p.ascent()+p.descent())/2,getWidth()*.022f,Paint.Align.CENTER,bold);}
        private void horn(Canvas c,float x,float y,float s){Path q=new Path();q.moveTo(x,y-s);q.lineTo(x-s*.23f,y+s*.12f);q.lineTo(x+s*.23f,y+s*.12f);q.close();p.setColor(0xFFFFF7D6);c.drawPath(q,p);stroke.setStrokeWidth(Math.max(3,s*.045f));for(int i=0;i<4;i++){stroke.setColor(MAGIC[i]);float yy=y-s*(.72f-i*.22f);c.drawLine(x-s*(.07f+i*.025f),yy,x+s*(.07f+i*.025f),yy+s*.05f,stroke);}}
        private void mane(Canvas c,float x,float y,float s){for(int i=0;i<5;i++){p.setColor(MAGIC[i]);c.drawCircle(x+s*.04f*i,y+s*.13f*i,s*(.105f-i*.007f),p);}}
        private void cloud(Canvas c,float x,float y,float s){p.setColor(0xEEFFFFFF);c.drawCircle(x-s*.4f,y,s*.35f,p);c.drawCircle(x,y-s*.15f,s*.48f,p);c.drawCircle(x+s*.45f,y,s*.32f,p);round(c,x-s*.7f,y,x+s*.7f,y+s*.32f,s*.14f,p);}
        private void hanger(Canvas c,float x,float y,float s,int color){stroke.setColor(color);stroke.setStrokeWidth(s*.07f);c.drawArc(new RectF(x-s*.12f,y-s*.18f,x+s*.12f,y+s*.08f),180,210,false,stroke);c.drawLine(x,y+s*.05f,x-s*.75f,y+s*.55f,stroke);c.drawLine(x,y+s*.05f,x+s*.75f,y+s*.55f,stroke);c.drawLine(x-s*.75f,y+s*.55f,x+s*.75f,y+s*.55f,stroke);}
        private void bow(Canvas c,float x,float y,float s){p.setColor(0xFFFF5F96);c.drawOval(new RectF(x-s,y-s*.5f,x,y+s*.5f),p);c.drawOval(new RectF(x,y-s*.5f,x+s,y+s*.5f),p);p.setColor(0xFFFFD166);c.drawCircle(x,y,s*.25f,p);}
        private void heart(Canvas c,float x,float y,float s,int color){Path q=new Path();q.moveTo(x,y+s);q.cubicTo(x-s*1.3f,y,x-s*.5f,y-s,x,y-s*.25f);q.cubicTo(x+s*.5f,y-s,x+s*1.3f,y,x,y+s);p.setColor(color);c.drawPath(q,p);}
        private void star(Canvas c,float x,float y,float r,Paint paint){Path q=new Path();for(int i=0;i<10;i++){double a=-Math.PI/2+i*Math.PI/5;float rr=i%2==0?r:r*.42f,xx=x+(float)Math.cos(a)*rr,yy=y+(float)Math.sin(a)*rr;if(i==0)q.moveTo(xx,yy);else q.lineTo(xx,yy);}q.close();c.drawPath(q,paint);}
        private void round(Canvas c,float l,float t,float r,float b,float rad,Paint paint){c.drawRoundRect(new RectF(l,t,r,b),rad,rad,paint);}
        private void text(Canvas c,String s,float x,float y,float size,Paint.Align align,boolean bold){p.setShader(null);p.setStyle(Paint.Style.FILL);p.setTextAlign(align);p.setTextSize(size);p.setFakeBoldText(bold);c.drawText(s,x,y,p);p.setFakeBoldText(false);}
        private void addBubble(float x,float y,float r){bubbles.add(new Bubble(x,y,r,.75f+rnd.nextFloat()*1.2f,35+rnd.nextFloat()*45,rnd.nextFloat()*6.28f));}
        private void burst(float x,float y,int n){for(int i=0;i<n;i++){float a=(float)(rnd.nextFloat()*Math.PI*2),v=70+rnd.nextFloat()*180;particles.add(new Particle(x,y,(float)Math.cos(a)*v,(float)Math.sin(a)*v-60,.65f+rnd.nextFloat()*.85f,MAGIC[rnd.nextInt(MAGIC.length)],5+rnd.nextFloat()*9));}}
        private void updateParticles(float dt){for(int i=particles.size()-1;i>=0;i--){Particle q=particles.get(i);q.life-=dt;q.x+=q.vx*dt;q.y+=q.vy*dt;q.vy+=190*dt;if(q.life<=0)particles.remove(i);}}
        private void drawParticles(Canvas c){for(Particle q:particles){p.setColor(Color.argb((int)(255*Math.min(1,q.life)),Color.red(q.color),Color.green(q.color),Color.blue(q.color)));star(c,q.x,q.y,q.size,p);}}
        private float rand(float a,float b){return a+rnd.nextFloat()*(b-a);}
        private static float cap(float v){return Math.max(0,Math.min(100,v));}
        private static int clamp(int v,int a,int b){return Math.max(a,Math.min(b,v));}
        private static float clampf(float v,float a,float b){return Math.max(a,Math.min(b,v));}
        private static float dist(float x1,float y1,float x2,float y2){float dx=x1-x2,dy=y1-y2;return(float)Math.sqrt(dx*dx+dy*dy);}
        private static int blend(int a,int b,float k){return Color.rgb((int)(Color.red(a)+(Color.red(b)-Color.red(a))*k),(int)(Color.green(a)+(Color.green(b)-Color.green(a))*k),(int)(Color.blue(a)+(Color.blue(b)-Color.blue(a))*k));}

        static final class Particle{float x,y,vx,vy,life;final int color;final float size;Particle(float x,float y,float vx,float vy,float life,int color,float size){this.x=x;this.y=y;this.vx=vx;this.vy=vy;this.life=life;this.color=color;this.size=size;}}
        static final class Bubble{float x,y,r,life,speed,phase;Bubble(float x,float y,float r,float life,float speed,float phase){this.x=x;this.y=y;this.r=r;this.life=life;this.speed=speed;this.phase=phase;}}
        static final class Platform{float x,y,w,phase;Platform(float x,float y,float w){this.x=x;this.y=y;this.w=w;this.phase=x*.01f;}}
        static final class Gate{float x,gapY,gap;boolean counted;Gate(float x,float gapY,float gap){this.x=x;this.gapY=gapY;this.gap=gap;}}
    }
}
